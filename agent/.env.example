# OpenAI Configuration (Required)
# Get your API key from https://platform.openai.com/api-keys
# Note: ChatGPT subscription tokens do NOT work for API usage
OPENAI_API_KEY=sk-your-openai-api-key-here

# LiveKit Configuration (Required for cloud deployment, optional for local dev)
# Get these from https://cloud.livekit.io (free tier available)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Model Configuration (Optional - defaults shown)
# LLM: gpt-4o, gpt-4o-mini, gpt-4-turbo, or gpt-3.5-turbo
LLM_MODEL=gpt-4o-mini

# STT: whisper-1 (OpenAI Whisper)
STT_MODEL=whisper-1

# TTS: tts-1 (standard) or tts-1-hd (higher quality, slower)
TTS_MODEL=tts-1

# TTS Voice: alloy, echo, fable, onyx, nova, shimmer
# Onyx is recommended for AstroLB-3 (deep, calm, professional)
TTS_VOICE=onyx

# Development Settings (Optional)
LOG_LEVEL=INFO
